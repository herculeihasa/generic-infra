# Force LF line endings in the working tree so that `terraform fmt -check`
# produces identical results on Windows workstations and Linux CI runners
# (core.autocrlf=true would otherwise check .tf files out with CRLF).
* text=auto eol=lf

*.tf        text eol=lf
*.tfvars    text eol=lf
*.hcl       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf
