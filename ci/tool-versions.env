# -----------------------------------------------------------------------------
# Pinned CI tool versions: the single source of truth for GitHub Actions and
# local runs (ci/scripts/install-tools.sh). Binaries are verified against the
# SHA-256 below (linux amd64 release assets) before use.
#
# Terraform itself is pinned per project in <project>/.terraform-version.
# Update procedure: bump version + checksum together, in a dedicated PR.
# -----------------------------------------------------------------------------

# Oldest Terraform version the child modules declare (required_version >= 1.9).
TERRAFORM_MIN_VERSION=1.9.8

TFLINT_VERSION=0.66.0
TFLINT_SHA256=22be11cadc25cd02401e94c0ccc91aa63467debb8485c2a755d98f4c0a9d1e2e

TRIVY_VERSION=0.76.2
TRIVY_SHA256=bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf

GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb

ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8

# Python package, installed in an isolated virtual environment.
CHECKOV_VERSION=3.4.5

# pre-commit framework (Python package): installed with pipx by the
# pre-commit workflow and on workstations (docs/pre-commit.md). Hook
# versions are pinned in .pre-commit-config.yaml; gitleaks and actionlint
# there must match the versions above (ci/tests/test_precommit.py).
PRE_COMMIT_VERSION=4.7.0
